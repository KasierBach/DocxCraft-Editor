NODE_ENV=production
HOST=127.0.0.1
PORT=4175
DATA_DIR=./data/documents
LOG_LEVEL=info

# Persistence. `file` (default) keeps the self-host single-machine layout.
# `postgres` stores metadata in Postgres and .docx blobs in BLOB_DIR / object storage.
# DOCUMENT_STORE=postgres
# DATABASE_URL=postgres://docxcraft:docxcraft@127.0.0.1:5432/docxcraft
# BLOB_DIR=./data/blobs

# Comma-separated list of allowed CORS origins. Use * to allow all (not recommended for production).
# Leave unset to disable CORS (same-origin deployments only).
# CORS_ORIGIN=https://editor.example.com

# Passphrase auth for public deployments. Preferred: the scrypt hash from
# `npm run hash-passphrase -- "your-passphrase"`. Alternative: set the
# plaintext passphrase (hashed at boot). Leave both unset to disable auth.
# AUTH_PASSPHRASE_HASH=scrypt:<salt>:<hash>
# AUTH_PASSPHRASE=
# AUTH_MODE=claim lets the first visitor set the passphrase (instance
# claiming); the hash persists in data/auth.json. Ideal for fresh deploys.
# AUTH_MODE=claim
# AUTH_STATE_FILE=./data/auth.json
