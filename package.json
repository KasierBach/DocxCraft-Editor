{
  "name": "docx-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:plain": "tsx scripts/dev-plain.ts",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "server": "tsx server/index.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:backup": "tsx scripts/backup-postgres.ts",
    "db:restore-drill": "tsx scripts/backup-postgres.ts --drill",
    "db:test:up": "docker compose -f docker-compose.dev.yml up -d --wait postgres-test",
    "db:migrate:docker": "docker compose -f docker-compose.dev.yml --profile migrate run --build --rm postgres-migrate",
    "db:test:migrate:docker": "docker compose -f docker-compose.dev.yml --profile migrate run --build --rm postgres-test-migrate",
    "hash-passphrase": "tsx scripts/hash-passphrase.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:load": "tsx scripts/load-test.ts",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prisma": "^7.10.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.16",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@eigenpal/docx-editor-core": "^1.0.2",
    "@eigenpal/docx-editor-react": "^1.0.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fontsource/fraunces": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-query": "^5.102.8",
    "fastify": "^5.8.5",
    "jszip": "^3.10.2",
    "openid-client": "^6.8.8",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.3",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.1",
    "prosemirror-view": "^1.42.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.18.3",
    "tsx": "^4.22.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
