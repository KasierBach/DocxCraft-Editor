# Copy to deploy/.env and fill in — never commit the filled-in file.
#
# Required
# --------
# Any long random string; it secures the bundled Postgres.
POSTGRES_PASSWORD=

# Public origin the browser uses. Must match the OAuth redirect URIs exactly
# (scheme, host, no trailing slash). Free TLS host example:
#   https://docx-<vm-ip-with-dashes>.sslip.io
APP_BASE_URL=

# The hostname Caddy serves and requests a certificate for (same host as APP_BASE_URL).
#   docx-<vm-ip-with-dashes>.sslip.io
SITE_ADDRESS=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI to register: ${APP_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
# Authorization callback URL to register: ${APP_BASE_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional (defaults shown)
# IMAGE_TAG=v0.2.0            # pin the release instead of :latest
# LOG_LEVEL=info
# SESSION_TTL_DAYS=30
# MAX_DOCUMENTS_PER_USER=100
# MAX_STORAGE_BYTES_PER_USER=104857600   # 100 MB
